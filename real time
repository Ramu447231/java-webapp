## 5) Jenkins pipeline (root `Jenkinsfile`)

This Jenkinsfile builds all services in parallel and deploys to k8s. It uses environment variables for registry, credentials, and kubeconfig.

```groovy
pipeline {
  agent any

  environment {
    REGISTRY = credentials('DOCKER_REGISTRY_URL') // or plain text var
    DOCKER_USER = credentials('DOCKER_USERNAME')
    DOCKER_PASS = credentials('DOCKER_PASSWORD')
    KUBECONFIG_CREDENTIALS = credentials('KUBECONFIG_BASE64') // base64 encoded kubeconfig
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build & Push Images') {
      parallel {
        stage('Build auth') {
          steps {
            dir('services/auth-service') {
              sh 'docker build -t $REGISTRY/auth-service:${GIT_COMMIT}-${BUILD_NUMBER} .'
              sh 'echo $DOCKER_PASS | docker login $REGISTRY -u $DOCKER_USER --password-stdin'
              sh 'docker push $REGISTRY/auth-service:${GIT_COMMIT}-${BUILD_NUMBER}'
            }
          }
        }

        stage('Build user') {
          steps {
            dir('services/user-service') {
              sh 'docker build -t $REGISTRY/user-service:${GIT_COMMIT}-${BUILD_NUMBER} .'
              sh 'echo $DOCKER_PASS | docker login $REGISTRY -u $DOCKER_USER --password-stdin'
              sh 'docker push $REGISTRY/user-service:${GIT_COMMIT}-${BUILD_NUMBER}'
            }
          }
        }

        stage('Build payment') {
          steps {
            dir('services/payment-service') {
              sh 'docker build -t $REGISTRY/payment-service:${GIT_COMMIT}-${BUILD_NUMBER} .'
              sh 'echo $DOCKER_PASS | docker login $REGISTRY -u $DOCKER_USER --password-stdin'
              sh 'docker push $REGISTRY/payment-service:${GIT_COMMIT}-${BUILD_NUMBER}'
            }
          }
        }
      } // parallel
    }

    stage('Deploy to Kubernetes') {
      steps {
        // restore kubeconfig file from base64 credential
        sh '''
          echo "$KUBECONFIG_CREDENTIALS" | base64 -d > kubeconfig
          export KUBECONFIG=$PWD/kubeconfig
        '''

        // Replace IMAGE_TAG placeholder in k8s manifests and apply
        sh '''
          IMAGE_TAG=${GIT_COMMIT}-${BUILD_NUMBER}
          REG=${REGISTRY}
          for svc in auth user payment; do
            sed "s|<REGISTRY>|${REG}|g; s|IMAGE_TAG|${IMAGE_TAG}|g" k8s/overlays/dev/${svc}-deployment.yaml > /tmp/${svc}-deploy.yaml
            kubectl apply -f /tmp/${svc}-deploy.yaml
          done
        '''
      }
    }
  }

  post {
    always {
      echo "Pipeline finished"
    }
  }
}
```

**Notes:**

* Add Jenkins credentials of kind "Secret text" for DOCKER_USERNAME, DOCKER_PASSWORD and DOCKER_REGISTRY_URL, and base64-encoded kubeconfig (KUBECONFIG_BASE64).
* Instead of base64 kubeconfig you can mount a kubeconfig file into Jenkins or use the Kubernetes plugin and a service account.

